11:["$","article",null,{"id":"anchor-case","className":"case","children":[["$","div",null,{"className":"case-title","children":[["$","span",null,{"className":"case-number","children":"B"}],["$","h3",null,{"children":["传送的价值，",["$","br",null,{}],"来自落点的判断。"]}]]}],["$","div",null,{"className":"case-body","children":[["$","p",null,{"children":"开镜射击直接击杀敌人后，玩家获得一个临时传送锚点。远处的锚点可以缩短路程、帮助脱战，也能在坠落时提供自救机会；是否前往，则取决于落点附近的威胁。"}],["$","figure",null,{"className":"case-proof","children":[["$","video",null,{"controls":true,"playsInline":true,"preload":"none","poster":"./media/evidence/anchor-evidence.jpg","aria-label":"AILURONE 传送锚点引导与成功到达实机片段","children":["$","source",null,{"src":"./media/evidence/anchor-evidence.mp4","type":"video/mp4"}]}],["$","figcaption",null,{"children":["锚点显示距离与剩余时间；引导期间 Dash 锁定，成功到达后恢复。",["$","span",null,{"className":"clip-source","children":"连续原速实机 · 11 秒 · 原片 06:09.5–06:20.5"}]]}]]}],["$","ol",null,{"className":"scan-stages","aria-label":"传送决策流程","children":[["$","li",null,{"children":[["$","span",null,{"children":"01 / 产生机会"}],["$","strong",null,{"children":"击杀生成锚点"}],"选择存续时间和范围内的目标。"]}],["$","li",null,{"children":[["$","span",null,{"children":"02 / 做出判断"}],["$","strong",null,{"children":"确认后开始引导"}],"暂时停火，引导期间仍能有限移动。"]}],["$","li",null,{"children":[["$","span",null,{"children":"03 / 承担结果"}],["$","strong",null,{"children":"到达或取消"}],"成功消耗锚点；发现危险时可主动中止。"]}]]}],["$","div",null,{"className":"case-detail","children":[["$","h4",null,{"children":"为什么加入主动取消"}],["$","p",null,{"children":"玩家开始传送后，仍可能发现落点危险。我加入再次按键取消，让玩家有机会撤回决定。有效受伤也会打断引导；取消本身不消耗锚点，但它仍受原有存续时间限制。"}]]}],["$","p",null,{"className":"evidence-note","children":"片段展示成功传送；主动取消与受伤中断规则详见机制说明。"}],["$","a",null,{"className":"mechanic-link","href":"./notes/AILURONE_Teleport_Anchor_Design.pdf","target":"_blank","rel":"noreferrer","children":"阅读传送锚点设计说明 · 3 页 PDF ↗"}],["$","p",null,{"className":"takeaway","children":"短暂的引导、有限的机会窗口和落点威胁，共同决定“这次位移是否值得”。"}]]}]]}]
12:["$","article",null,{"id":"enemy-case","className":"case","children":[["$","div",null,{"className":"case-title","children":[["$","span",null,{"className":"case-number","children":"C"}],["$","h3",null,{"children":["让敌人也成为",["$","br",null,{}],"移动系统的一部分。"]}]]}],["$","div",null,{"className":"case-body","children":[["$","div",null,{"className":"case-detail","children":[["$","h4",null,{"children":"Spike · 诱导失误与反击"}],["$","p",null,{"children":"我为近身蓄力冲撞设计了撞墙后的停顿窗口。玩家可以横向冲刺或二段跳躲避，再利用窗口反击，也能尝试引诱敌人冲出平台。"}]]}],["$","div",null,{"className":"case-detail","children":[["$","h4",null,{"children":"Octahedron · 从固定陷阱到移动资源"}],["$","p",null,{"children":"我将它的简单死亡改为延时爆炸击飞，并在设计时考虑与传送锚点组合：远处击杀、传送靠近、借爆炸快速移动。该次爆炸本身保留至少 1 点生命；爆炸前的等待给玩家调整站位和到达时机的空间。"}]]}],["$","p",null,{"className":"takeaway","children":"敌人的行为既构成威胁，也给玩家能力提供具体的使用机会。"}]]}]]}]
13:["$","article",null,{"id":"locator-case","className":"case","children":[["$","div",null,{"className":"case-title","children":[["$","span",null,{"className":"case-number","children":"D"}],["$","h3",null,{"children":["什么时候应该",["$","br",null,{}],"把敌人标出来？"]}]]}],["$","div",null,{"className":"case-body","children":[["$","p",null,{"children":"最终房间有大量必须击杀的敌人。早期持续显示的白框在密集战斗中互相叠加，身后目标尤其难辨认；而战斗接近结束时，玩家又需要尽快找到残敌。我据此把提示分成三个阶段。"}],["$","ol",null,{"className":"scan-stages","aria-label":"最终房间敌人定位的三个阶段","children":[["$","li",null,{"children":[["$","span",null,{"children":"进入战斗"}],["$","strong",null,{"children":"短暂扫描"}],"本关清场战斗首次激活时，短暂显示目标轮廓，帮助建立方位感。"]}],["$","li",null,{"children":[["$","span",null,{"children":"密集交火"}],["$","strong",null,{"children":"收起常驻标记"}],"不持续给每个敌人加定位框，为瞄准、走位和受击反馈留出空间。"]}],["$","li",null,{"children":[["$","span",null,{"children":"剩余 1–5 个目标"}],["$","strong",null,{"children":"持续定位"}],"标记跟随存活目标移动，帮助玩家完成最后的搜索与清场。"]}]]}],["$","div",null,{"className":"proof-pair","children":[["$","figure",null,{"className":"case-proof","children":[["$","video",null,{"controls":true,"playsInline":true,"preload":"none","poster":"./media/evidence/locator-entry-evidence.jpg","aria-label":"AILURONE 入场附近的红色敌人轮廓实机片段","children":["$","source",null,{"src":"./media/evidence/locator-entry-evidence.mp4","type":"video/mp4"}]}],["$","figcaption",null,{"children":["红色轮廓穿过遮挡显示敌人的位置。",["$","span",null,{"className":"clip-source","children":"连续原速实机 · 11 秒 · 原片 04:42.5–04:53.5"}]]}]]}],["$","figure",null,{"className":"case-proof","children":[["$","video",null,{"controls":true,"playsInline":true,"preload":"none","poster":"./media/evidence/locator-evidence.jpg","aria-label":"AILURONE 收尾阶段敌人方向与距离定位实机片段","children":["$","source",null,{"src":"./media/evidence/locator-evidence.mp4","type":"video/mp4"}]}],["$","figcaption",null,{"children":["屏外方向与距离提示，配合敌人头顶标记寻找目标。",["$","span",null,{"className":"clip-source","children":"连续原速实机 · 12 秒 · 原片 05:58–06:10"}]]}]]}]]}],["$","p",null,{"className":"evidence-note",